# Copy to .env (never commit .env)
PORT=8080
DATA_DIR=./data
# Min gap between any two TTC requests (be gentle)
TTC_MIN_INTERVAL_MS=700
# Hot set: polled every HOT_INTERVAL_MS. Stops by TTC id, routes by short name.
HOT_INTERVAL_MS=30000
HOT_STOPS=1:1405,1:1408,1:1406
HOT_ROUTES=
# City-wide sweep of all routes' positions, one request every N ms (0 = off)
SWEEP_INTERVAL_MS=1500
# Max TTC requests waiting at once (~0.7 s each); past this, callers get 503 immediately
TTC_MAX_QUEUE=40
# Per-IP requests per minute: all API routes / POST /chat (costs Claude tokens)
RATE_LIMIT_PER_MIN=60
CHAT_RATE_LIMIT_PER_MIN=10
# Proxies allowed to set X-Forwarded-For (docker compose sets this for Caddy). Empty = trust none.
TRUST_PROXY=
# Bearer key the app and AI tools send to /chat and /mcp. Leave empty only for local dev.
# It ships inside the app bundle, so it is a speed bump, not a secret; the rate limits do the real work.
API_KEY=
# Encrypts stored trips (32 bytes): openssl rand -base64 32. Without it, stored trips and alerts are off.
# Losing it makes stored trips unreadable; users would just re-sync from their phones.
TRIPS_KEY=
# Optional: Expo push security token
EXPO_ACCESS_TOKEN=
# Enables /chat. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Which model answers /chat: anthropic | gemini. Unset = Anthropic if its key is set, else Gemini.
# Free testing: a key from https://aistudio.google.com/apikey, AI_PROVIDER=gemini, restart the API.
# Demo: AI_PROVIDER=anthropic (or remove it) and restart.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried when the main model is overloaded (503/429) after 3 tries
GEMINI_FALLBACK_MODEL=
# Public hostname for Caddy on the VPS
DOMAIN=
# Tbilisi hours with no buses: sweep paused, hot set every 5 min
QUIET_FROM_HOUR=1
QUIET_TO_HOUR=6
# Google Places (New) Text Search as the first place-search source. Empty key = off. Daily cap = real Google calls per Tbilisi day.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_CAP=500
