{
  "expo": {
    "name": "მოასწრებ",
    "slug": "tbilisi-transit",
    "version": "0.2.0",
    "owner": "gigoshkins-team",
    "extra": { "eas": { "projectId": "f84026bd-0b86-4e92-9657-94a713b14892" } },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ge.hacktoberfest.transit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Connects to the dev server on your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ge.hacktoberfest.transit"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      ["react-native-notify-kit", { "android": { "icons": [{ "name": "ic_leave_card", "path": "./assets/android-icon-monochrome.png", "type": "small" }], "foregroundService": { "types": ["dataSync"] } } }],
      "@react-native-community/datetimepicker",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 220, "backgroundColor": "#FFFFFF", "resizeMode": "contain" }],
      ["expo-image-picker", { "cameraPermission": "Take a photo to send in the chat.", "photosPermission": "Choose photos to send in the chat.", "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "Your location is used to find nearby stops and plan from where you are." }],
      ["expo-media-library", { "photosPermission": "Choose photos to send in the chat.", "savePhotosPermission": false, "isAccessMediaLocationEnabled": false }]
    ],
    "scheme": "tbilisitransit"
  }
}
